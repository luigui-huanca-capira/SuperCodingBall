{
  "rules": {
    ".read": false,
    ".write": false,
    "users": {
      "$uid": {
        ".read": "auth != null",
        ".write": "auth != null && auth.uid === $uid",
        "displayName": {
          ".validate": "newData.isString() && newData.val().length <= 20"
        },
        "pictureUrl": {
          ".validate": "newData.val() === null || newData.isString()"
        },
        "updatedAt": {
          ".validate": "newData.isNumber()"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "strategies": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid",
        "blocks": {
          ".validate": "newData.isString()"
        },
        "updatedAt": {
          ".validate": "newData.isNumber()"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "games": {
      "$dayTimestamp": {
        ".read": "auth != null",
        "$uid": {
          ".write": "auth != null && auth.uid === $uid",
          "userDisplay": {
            "displayName": {
              ".validate": "newData.isString() && newData.val().length <= 20"
            },
            "pictureUrl": {
              ".validate": "newData.val() === null || newData.isString()"
            },
            "$other": {
              ".validate": false
            }
          },
          "dailyGames": {
            "$opponentId": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 2"
            }
          },
          "$other": {
            ".validate": false
          }
        }
      }
    },
    "leaderboard": {
      "$uid": {
        ".read": "auth != null",
        ".write": "auth != null && auth.uid === $uid",
        "displayName": {
          ".validate": "newData.isString() && newData.val().length <= 20"
        },
        "points": {
          ".validate": "newData.isNumber()"
        },
        "ranking": {
          ".validate": "newData.isNumber()"
        },
        "lastSeen": {
          ".validate": "newData.isNumber()"
        },
        "updatedAt": {
          ".validate": "newData.isNumber()"
        },
        "$other": {
          ".validate": false
        }
      }
    }
  }
}
